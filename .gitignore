# macOS
.DS_Store

# Xcode 사용자별 설정 (창 배치, 스킴 순서 등)
xcuserdata/
*.xcuserstate

# 빌드 결과물
DerivedData/
build/

# Swift Package Manager
.build/

# 진단 결과 중 큰 표본 원본(.tsv)은 압축본(.tsv.gz)만 저장
Diagnostics/**/*.tsv

# FanProbe의 powermetrics 원본은 압축본(.txt.gz)만 저장
Diagnostics/FanProbe/results/*-pm.txt

# 위젯 2판 진단 결과 (스크립트만 커밋)
Diagnostics/WidgetV2/*.txt
